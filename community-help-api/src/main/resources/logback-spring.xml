<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name"/>
    <!-- Patrón para logs en consola -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Patrón para logs en fichero -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Muestra logs en la terminal -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <springProfile name="dev">

        <!-- Logs de la aplicación -->
        <logger name="com.communityhelp.app" level="DEBUG"/>

        <!-- Hibernate: ver queries SQL -->
        <logger name="org.hibernate.SQL" level="DEBUG"/>

        <!-- Hibernate: ver parámetros de queries -->
        <logger name="org.springframework.security" level="DEBUG"/>

        <!-- Logs de Spring Web -->
        <logger name="org.springframework.web" level="DEBUG"/>

        <!-- Logger raíz -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

    </springProfile>

    <springProfile name="prod">

        <appender name="FILE"
                  class="ch.qos.logback.core.rolling.RollingFileAppender">

            <!-- Archivo principal -->
            <file>logs/community-help.log</file>

            <!-- Política de rotación: por fecha + tamaño -->
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

                <!-- Nombre de archivos rotados -->
                <fileNamePattern>logs/community-help.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

                <!-- Rotación también por tamaño -->
                <timeBasedFileNamingAndTriggeringPolicy
                        class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                    <maxFileSize>10MB</maxFileSize>
                </timeBasedFileNamingAndTriggeringPolicy>

                <!-- Mantener logs 30 días -->
                <maxHistory>30</maxHistory>

            </rollingPolicy>

            <encoder>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <!-- Logs de la app -->
        <logger name="com.communityhelp.app" level="INFO"/>

        <!-- Hibernate más silencioso -->
        <logger name="org.hibernate.SQL" level="WARN"/>

        <!-- Spring más silencioso -->
        <logger name="org.springframework" level="WARN"/>

        <!-- Logger raíz -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

    <springProfile name="!dev &amp; !prod &amp; !test">

        <!-- Reutiliza el comportamiento de producción -->
        <logger name="com.communityhelp.app" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>

        <!-- Appender FILE -->
        <appender name="FILE"
                  class="ch.qos.logback.core.rolling.RollingFileAppender">

            <file>logs/community-help.log</file>

            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/community-help.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

                <timeBasedFileNamingAndTriggeringPolicy
                        class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                    <maxFileSize>10MB</maxFileSize>
                </timeBasedFileNamingAndTriggeringPolicy>

                <maxHistory>30</maxHistory>
            </rollingPolicy>

            <encoder>
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

</configuration>