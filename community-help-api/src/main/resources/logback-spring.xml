<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name"/>

    <!-- Patrón para logs en consola -->
    <property name="LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Patrón para logs en fichero -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Muestra logs en la terminal -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Appender FILE común reutilizable -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- Archivo principal -->
        <file>logs/community-help.log</file>

        <!-- Política de rotación: por fecha + tamaño -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <!-- Nombre de archivos rotados -->
            <fileNamePattern>logs/community-help.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <!-- Rotación también por tamaño -->
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>10MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>

            <!-- Mantener logs 30 días -->
            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>${FILE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <springProfile name="dev | local">

        <!-- Logs de la aplicación -->
        <logger name="com.communityhelp.app" level="DEBUG"/>

        <!-- Hibernate: ver queries SQL -->
        <logger name="org.hibernate.SQL" level="DEBUG"/>

        <!-- Hibernate: ver parámetros de queries -->
        <logger name="org.springframework.security" level="DEBUG"/>

        <!-- Logs de Spring Web -->
        <logger name="org.springframework.web" level="DEBUG"/>

        <!-- Logger raíz -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

    </springProfile>

    <springProfile name="prod">

        <!-- Logs de la app -->
        <logger name="com.communityhelp.app" level="INFO"/>

        <!-- Hibernate más silencioso -->
        <logger name="org.hibernate.SQL" level="WARN"/>

        <!-- Spring más silencioso -->
        <logger name="org.springframework" level="WARN"/>

        <!-- Logger raíz -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

    <springProfile name="!dev &amp; !prod &amp; !test">

        <logger name="com.communityhelp.app" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

</configuration>